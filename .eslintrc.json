{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "css/fontawesome/**",
    "js/*.min.js",
    "js/bootstrap.min.js",
    "js/owl.carousel.min.js",
    "js/owljquery.min.js"
  ],
  "globals": {
    "$": "readonly",
    "bootstrap": "readonly",
    "EgoTechUtils": "readonly",
    "google": "readonly"
  },
  "rules": {
    "no-console": "off",
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "no-empty": "off",
    "no-func-assign": "off",
    "no-unsafe-finally": "off",
    "no-inner-declarations": "off"
  }
}
